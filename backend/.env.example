# Techspire Django REST Backend Environment Configuration

# Django Core
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.onrender.com,.railway.app

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# CORS Configuration (Comma-separated Next.js frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://techspire.vercel.app

# Razorpay API Credentials (Backend Only - NEVER expose to frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend Base URL (For emails & receipts)
FRONTEND_URL=
